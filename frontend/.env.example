# Where the Vite dev proxy forwards /api/* (the FastAPI backend).
VITE_API_TARGET=http://127.0.0.1:8000

# Optional: call the API directly instead of through the proxy
# (requires CORS on the backend). Defaults to /api.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Max cases fetched for one hour (the busiest hour has ~4k).
VITE_CASE_LIMIT=10000
